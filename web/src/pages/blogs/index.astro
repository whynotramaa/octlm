---
import { getCollection } from "astro:content";
import Base from "../../layouts/Base.astro";
import Chip from "../../components/Chip.astro";
import { roadmap } from "../../lib/roadmap.ts";

const posts = (await getCollection("posts")).sort((a, b) => a.data.day - b.data.day || a.data.order - b.data.order);
const planned = roadmap();
const days = [...new Set(posts.map((post) => post.data.day))]
  .sort((a, b) => a - b)
  .map((day) => ({
    day,
    title: planned.find((entry) => entry.day === day)?.title ?? "start here",
    posts: posts.filter((post) => post.data.day === day),
  }));
const title = (text: string) => text.charAt(0).toUpperCase() + text.slice(1);
---

<Base title="Blog · octlm" description="Every octlm post, day by day, from the first tokenizer to the tool-use fine-tune.">
  <div class="index">
    <section class="hero">
      <div class="hero-meta">
        <span class="label">The build log</span>
        <span class="label">{posts.length} posts · {days.length} days</span>
      </div>
      <h1>
        <span class="line"><span>Building a small language model</span></span>
        <span class="line"><span><em>and checking every step.</em></span></span>
      </h1>
      <div class="hero-foot">
        <p class="lede">
          octlm is a decoder written from scratch in PyTorch. These posts explain each piece: what it does, how we built it,
          what it measured, and what we chose not to build. Playgrounds let you test the ideas; tests compare model-math
          playgrounds with the Python code.
        </p>
        <div class="actions">
          <a class="btn" href={`/blogs/${posts[0].id}/`}>
            Start reading
            <svg viewBox="0 0 20 20" aria-hidden="true"><path d="M4 10h11m-4-4.5L15.5 10 11 14.5" /></svg>
          </a>
          <a class="btn ghost" href="/roadmap/">Roadmap</a>
        </div>
      </div>
    </section>

    {days.map((day) => (
      <section class="day" aria-labelledby={`day-${day.day}`}>
        <header class="day-head">
          <span class="label">Day</span>
          <h2 id={`day-${day.day}`} class="day-num"><span class="visually-hidden">Day </span>{String(day.day).padStart(2, "0")}</h2>
          <p class="day-topic">{title(day.title)}</p>
          <p class="day-count" aria-hidden="true">{day.posts.map(() => <i />)}</p>
        </header>
        <ol class="posts">
          {day.posts.map((post, i) => (
            <li>
              <a href={`/blogs/${post.id}/`}>
                <span class="post-n">{String(day.day).padStart(2, "0")}.{i + 1}</span>
                <span class="post-text">
                  <span class="post-title">{post.data.title}</span>
                  <span class="post-description">{post.data.description}</span>
                </span>
                <span class="post-meta">
                  {post.data.draft && <Chip hue="blue">Draft</Chip>}
                  {!post.data.measured && <Chip hue={day.day === 3 ? "purple" : "orange"}>{day.day === 3 ? "Plan switched" : "Result pending"}</Chip>}
                  {post.data.exps.length > 0 && <span class="exps">{post.data.exps.join(" · ")}</span>}
                </span>
                <svg class="go" viewBox="0 0 20 20" aria-hidden="true"><path d="M4 10h11m-4-4.5L15.5 10 11 14.5" /></svg>
              </a>
            </li>
          ))}
        </ol>
      </section>
    ))}
  </div>
</Base>

<style>
  .index {
    max-width: calc(var(--page) + 2 * var(--gutter));
    margin: 0 auto;
    padding: 0 var(--gutter);
  }

  .hero { padding: clamp(56px, 9vw, 120px) 0 clamp(80px, 10vw, 144px); }
  .hero-meta { display: flex; justify-content: space-between; gap: 16px; }
  .hero h1 {
    font-size: clamp(44px, 6vw, 80px);
    line-height: 1;
    letter-spacing: -0.015em;
    margin: 32px 0 40px;
  }
  .line { display: block; padding-bottom: 0.08em; margin-bottom: -0.08em; }
  .line > span { display: inline-block; animation: rise 700ms var(--out) both; }
  .line:nth-child(2) > span { animation-delay: 80ms; }
  .hero-foot {
    display: grid;
    grid-template-columns: minmax(0, 3fr) minmax(0, 9fr);
    gap: 24px clamp(24px, 4vw, 64px);
    animation: fade 700ms var(--out) 260ms both;
  }
  .lede { grid-column: 2; font-size: 16.5px; line-height: 1.65; color: var(--ink-2); max-width: 60ch; margin: 0; }
  .actions { grid-column: 2; display: flex; flex-wrap: wrap; gap: 12px; }

  svg path { fill: none; stroke: currentColor; stroke-width: 1.7; stroke-linecap: round; stroke-linejoin: round; }

  .day {
    display: grid;
    grid-template-columns: minmax(0, 3fr) minmax(0, 9fr);
    gap: clamp(24px, 4vw, 64px);
    padding-top: 20px;
    margin-bottom: clamp(88px, 10vw, 136px);
  }
  .day-head { position: sticky; top: 28px; align-self: start; }
  .day-num { opacity: 0.18; font-family: var(--font-display); font-weight: 400; font-size: clamp(56px, 5.6vw, 76px); line-height: 0.95; letter-spacing: -0.02em; margin-top: 10px; }
  .day-topic { margin: 14px 0 0; font-size: 15px; line-height: 1.45; color: var(--ink-2); font-weight: 500; text-wrap: balance; max-width: 22ch; }
  .day-count { display: flex; gap: 4px; margin: 18px 0 0; }
  .day-count i { width: 6px; height: 6px; background: var(--ink-3); }

  .posts { list-style: none; margin: 0; padding: 0; }
  .posts li { transition: opacity 260ms var(--ease); }
  .posts:has(a:hover) li:not(:has(a:hover)),
  .posts:has(a:focus-visible) li:not(:has(a:focus-visible)) { opacity: 0.6; }

  .posts a {
    position: relative;
    display: grid;
    grid-template-columns: 48px minmax(0, 1fr) auto 20px;
    align-items: start;
    gap: 8px 24px;
    padding: 22px 0 26px;
    text-decoration: none;
    border-radius: 4px;
  }
  .post-n { font-family: var(--font-mono); font-size: 11.5px; color: var(--ink-3); padding-top: 9px; }
  .post-text { display: flex; flex-direction: column; gap: 8px; }
  .post-title {
    font-family: var(--font-display);
    font-size: clamp(23px, 2.2vw, 27px);
    line-height: 1.12;
    letter-spacing: -0.005em;
    color: var(--ink);
    text-wrap: balance;
    transition: transform 320ms var(--out);
  }
  .post-description {
    font-size: 14.5px;
    line-height: 1.55;
    color: var(--ink-3);
    max-width: 62ch;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
    transition: color 260ms var(--ease), transform 320ms var(--out);
  }
  .post-meta { display: flex; flex-wrap: wrap; justify-content: end; align-items: center; gap: 6px; padding-top: 6px; }
  .exps { font-family: var(--font-mono); font-size: 11.5px; color: var(--ink-3); white-space: nowrap; padding-top: 2px; }
  .go {
    width: 20px;
    height: 20px;
    margin-top: 8px;
    color: var(--signal);
    clip-path: inset(0 100% 0 0);
    transform: translateX(-6px);
    transition: clip-path 320ms var(--out), transform 320ms var(--out);
  }
  .posts a:hover .go, .posts a:focus-visible .go { clip-path: inset(0 0 0 0); transform: none; }
  .posts a:hover .post-title, .posts a:focus-visible .post-title,
  .posts a:hover .post-description, .posts a:focus-visible .post-description { transform: translateX(2px); }
  .posts a:hover .post-description, .posts a:focus-visible .post-description { color: var(--ink-2); }

  @keyframes rise { from { opacity: 0; translate: 0 6px; } }
  @keyframes fade { from { opacity: 0; } }

  @media (max-width: 820px) {
    .hero-foot, .day { grid-template-columns: minmax(0, 1fr); }
    .lede, .actions { grid-column: 1; }
    .day { gap: 12px; margin-bottom: 80px; }
    .day-head { position: static; display: flex; flex-wrap: wrap; align-items: baseline; gap: 4px 16px; }
    .day-head .label { display: none; }
    .day-num { font-size: 52px; margin: 0; }
    .day-topic { margin: 0; max-width: none; flex: 1; }
    .day-count { display: none; }
    .posts a { grid-template-columns: minmax(0, 1fr); padding: 18px 0 22px; }
    .post-n { padding-top: 0; }
    .post-meta { justify-content: start; padding-top: 0; }
    .go { display: none; }
  }

  @media (hover: none) {
    .posts:has(a:hover) li:not(:has(a:hover)) { opacity: 1; }
  }

  @media (prefers-reduced-motion: reduce) {
    .line > span, .hero-foot { animation: none; }
    .posts a:hover .post-title, .posts a:hover .post-description { transform: none; }
  }
</style>
