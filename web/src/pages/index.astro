      </header>
      <div class="tabs">
        {runs.map((tab, i) => <input type="radio" name="run" id={`tab-${tab.id}`} checked={i === 0} />)}
        <div class="tab-bar" role="presentation">
          {runs.map((tab) => <label for={`tab-${tab.id}`}>{tab.label}</label>)}
        </div>
        {runs.map((tab) => (
          <div class={`tab-panel panel-${tab.id}`}>
            <div class="term-bar"><span class="term-dots" aria-hidden="true"><i /><i /><i /></span><span class="term-title">octlm · {tab.label.toLowerCase()}</span><button type="button" class="term-btn copy" data-copy={tab.lines.map(([cmd]) => cmd).filter((cmd) => !cmd.startsWith("#")).join("\n")}>Copy</button></div>
            <pre class="tab-code">{tab.lines.map(([cmd, note]) => (cmd.startsWith("#") ? <div class="c">{cmd}</div> : <div><span class="ps">$</span>{cmd}{note && <span class="c">  {note}</span>}</div>))}</pre>
