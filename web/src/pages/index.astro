---
import { getCollection } from "astro:content";
import Base from "../layouts/Base.astro";
import Chip from "../components/Chip.astro";
import { roadmap } from "../lib/roadmap.ts";

const posts = (await getCollection("posts")).sort((a, b) => a.data.day - b.data.day || a.data.order - b.data.order);
const planned = roadmap();
const days = [...new Set(posts.map((post) => post.data.day))]
  .sort((a, b) => a - b)
  .map((day) => ({
    day,
    title: planned.find((entry) => entry.day === day)?.title ?? "start here",
    posts: posts.filter((post) => post.data.day === day),
  }));
const title = (text: string) => text.charAt(0).toUpperCase() + text.slice(1);
---

<Base title="octlm">
  <div class="index">
    <section class="hero">
      <h1>
        <span class="line"><span>Building a small language model</span></span>
        <span class="line"><span>and checking every step.</span></span>
      </h1>
      <p class="lede">
        octlm is a decoder written from scratch in PyTorch. These posts explain each piece: what it does, how we built it,
        what it measured, and what we chose not to build. Playgrounds let you test the ideas; tests compare model-math
        playgrounds with the Python code.
      </p>
      <div class="actions">
        <a class="primary" href={`/posts/${posts[0].id}/`}>
          Start reading
          <svg viewBox="0 0 20 20" aria-hidden="true"><path d="M4 10h11m-4-4.5L15.5 10 11 14.5" /></svg>
        </a>
        <a class="quiet" href="/roadmap/">See the roadmap</a>
      </div>
    </section>

    {days.map((day) => (
      <section class="day" aria-labelledby={`day-${day.day}`}>
        <header class="day-head">
          <h2 id={`day-${day.day}`}>Day {day.day}</h2>
          <p class="day-topic">{title(day.title)}</p>
          <p class="day-count">{day.posts.length} {day.posts.length === 1 ? "post" : "posts"}</p>
        </header>
        <ol class="posts">
          {day.posts.map((post) => (
            <li>
              <a href={`/posts/${post.id}/`}>
                <span class="post-text">
                  <span class="post-title">{post.data.title}</span>
                  <span class="post-description">{post.data.description}</span>
                </span>
                <span class="post-meta">
                  {post.data.draft && <Chip hue="blue">Draft</Chip>}
                  {!post.data.measured && <Chip hue={day.day === 3 ? "purple" : "orange"}>{day.day === 3 ? "Plan switched" : "Result pending"}</Chip>}
                  {post.data.exps.length > 0 && <span class="exps">{post.data.exps.join(" · ")}</span>}
                </span>
                <svg class="go" viewBox="0 0 20 20" aria-hidden="true"><path d="M4 10h11m-4-4.5L15.5 10 11 14.5" /></svg>
              </a>
            </li>
          ))}
        </ol>
      </section>
    ))}
  </div>
</Base>

<style>
  .index {
    --out: cubic-bezier(0.16, 1, 0.3, 1);
    max-width: calc(var(--wide) + 2 * var(--gutter));
    margin: 0 auto;
    padding: 0 var(--gutter);
  }

  .hero { max-width: var(--measure); padding: clamp(56px, 11vw, 136px) 0 clamp(64px, 9vw, 120px); }
  .hero h1 {
    font-size: clamp(40px, 6.6vw, 68px);
    line-height: 1.02;
    letter-spacing: -0.04em;
    font-weight: 700;
    text-wrap: balance;
    margin: 0 0 28px;
  }
  .line { display: block; overflow: clip; padding-bottom: 0.08em; margin-bottom: -0.08em; }
  .line > span { display: inline-block; animation: rise 820ms var(--out) both; }
  .line:nth-child(2) > span { animation-delay: 90ms; color: var(--ink-3); }
  .lede {
    font-size: 19px;
    line-height: 1.6;
    color: var(--ink-2);
    max-width: 62ch;
    margin: 0 0 36px;
    animation: fade 700ms var(--out) 260ms both;
  }
  .actions { display: flex; align-items: center; gap: 28px; animation: fade 700ms var(--out) 360ms both; }
  .primary {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    height: 48px;
    padding: 0 20px 0 22px;
    border-radius: var(--r-chip);
    background: var(--ink);
    color: var(--bg);
    font-weight: 600;
    font-size: 15.5px;
    text-decoration: none;
    box-shadow: 0 1px 2px rgb(0 0 0 / 0.08), 0 8px 20px -10px rgb(0 0 0 / 0.35);
    transition: transform 160ms var(--out), box-shadow 240ms var(--out);
  }
  .primary svg { width: 18px; height: 18px; transition: transform 240ms var(--out); }
  .primary:hover { box-shadow: 0 1px 2px rgb(0 0 0 / 0.08), 0 12px 28px -12px rgb(0 0 0 / 0.45); }
  .primary:hover svg { transform: translateX(3px); }
  .primary:active { transform: scale(0.97); }
  .quiet {
    font-weight: 560;
    font-size: 15.5px;
    color: var(--ink-2);
    text-decoration-color: var(--line-2);
    transition: color 160ms var(--ease), text-decoration-color 160ms var(--ease);
  }
  .quiet:hover { color: var(--ink); text-decoration-color: var(--ink); }

  svg path { fill: none; stroke: currentColor; stroke-width: 1.7; stroke-linecap: round; stroke-linejoin: round; }

  .day {
    display: grid;
    grid-template-columns: 248px minmax(0, 1fr);
    gap: 48px;
    padding-top: 36px;
    border-top: 1px solid var(--line-2);
    margin-bottom: 112px;
  }
  .day-head { position: sticky; top: 28px; align-self: start; }
  .day h2 { font-size: 30px; font-weight: 700; letter-spacing: -0.03em; line-height: 1.1; }
  .day-topic { margin: 10px 0 0; font-size: 16px; line-height: 1.45; color: var(--ink-2); font-weight: 500; text-wrap: balance; }
  .day-count { margin: 14px 0 0; font-size: 13px; color: var(--ink-3); font-variant-numeric: tabular-nums; }

  .posts { list-style: none; margin: -14px 0 0; padding: 0; }
  .posts li + li { border-top: 1px solid var(--line); }
  .posts li { transition: opacity 260ms var(--ease); }
  .posts:has(a:hover) li:not(:has(a:hover)),
  .posts:has(a:focus-visible) li:not(:has(a:focus-visible)) { opacity: 0.42; }

  .posts a {
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto 20px;
    align-items: start;
    gap: 8px 24px;
    padding: 22px 0 24px;
    text-decoration: none;
    border-radius: 4px;
  }
  .post-text { display: flex; flex-direction: column; gap: 6px; }
  .post-title {
    font-size: 19.5px;
    font-weight: 620;
    letter-spacing: -0.016em;
    line-height: 1.3;
    color: var(--ink);
    text-wrap: balance;
    transition: transform 320ms var(--out);
  }
  .post-description {
    font-size: 15px;
    line-height: 1.55;
    color: var(--ink-3);
    max-width: 62ch;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
    transition: color 260ms var(--ease), transform 320ms var(--out);
  }
  .post-meta { display: flex; flex-wrap: wrap; justify-content: end; align-items: center; gap: 6px; padding-top: 4px; }
  .exps { font-family: var(--font-mono); font-size: 12px; color: var(--ink-3); font-variant-numeric: tabular-nums; white-space: nowrap; padding-top: 2px; }
  .go {
    width: 20px;
    height: 20px;
    margin-top: 4px;
    color: var(--ink);
    clip-path: inset(0 100% 0 0);
    transform: translateX(-6px);
    transition: clip-path 320ms var(--out), transform 320ms var(--out);
  }
  .posts a:hover .go, .posts a:focus-visible .go { clip-path: inset(0 0 0 0); transform: none; }
  .posts a:hover .post-title, .posts a:focus-visible .post-title,
  .posts a:hover .post-description, .posts a:focus-visible .post-description { transform: translateX(4px); }
  .posts a:hover .post-description, .posts a:focus-visible .post-description { color: var(--ink-2); }
  .posts a:active .post-title { transform: translateX(2px); }

  @keyframes rise { from { transform: translateY(105%); } }
  @keyframes fade { from { opacity: 0; transform: translateY(8px); } }

  @media (max-width: 820px) {
    .day { grid-template-columns: 1fr; gap: 12px; margin-bottom: 80px; }
    .day-head { position: static; display: flex; flex-wrap: wrap; align-items: baseline; gap: 4px 12px; }
    .day-topic { margin: 0; flex-basis: 100%; }
    .day-count { display: none; }
    .posts { margin-top: 0; }
    .posts a { grid-template-columns: minmax(0, 1fr); padding: 18px 0 20px; }
    .post-meta { justify-content: start; padding-top: 0; }
    .go { display: none; }
    .lede { font-size: 17.5px; }
  }

  @media (hover: none) {
    .posts:has(a:hover) li:not(:has(a:hover)) { opacity: 1; }
  }

  @media (prefers-reduced-motion: reduce) {
    .line > span { animation: none; }
    .lede, .actions { animation: fade-only 300ms ease both; }
    .posts a:hover .post-title, .posts a:hover .post-description { transform: none; }
    @keyframes fade-only { from { opacity: 0; } }
  }
</style>
