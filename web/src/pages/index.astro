<script>
  const still = matchMedia("(prefers-reduced-motion: reduce)").matches;
  document.querySelectorAll<HTMLCanvasElement>("canvas.field").forEach((canvas) => {
    const ctx = canvas.getContext("2d");
    if (!ctx) return;
    const gap = 14;
    let cols = 0, rows = 0, width = 0, height = 0, visible = false, last = 0;
    const size = () => {
      const dpr = Math.min(devicePixelRatio, 2);
      width = canvas.clientWidth;
      height = canvas.clientHeight;
      canvas.width = width * dpr;
      canvas.height = height * dpr;
      ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
      cols = Math.ceil(width / gap);
      rows = Math.ceil(height / gap);
    };
    const draw = (t: number) => {
      const style = getComputedStyle(canvas);
      const dot = style.getPropertyValue("--dot-ink").trim();
      const signal = style.getPropertyValue("--signal").trim();
      ctx.clearRect(0, 0, width, height);
      for (let r = 0; r < rows; r++) {
        for (let c = 0; c < cols; c++) {
          const x = c / cols, y = r / rows;
          const v = (Math.sin(x * 6 + t * 0.0004) + Math.sin(y * 5 - t * 0.0003) + Math.sin((x - y) * 4 + t * 0.0005) + 3) / 6;
          const hot = (c * 7919 + r * 104729) % 97 === 0 && v > 0.62;
          ctx.globalAlpha = hot ? 1 : 0.25 + v * 0.75;
          ctx.fillStyle = hot ? signal : dot;
          ctx.beginPath();
          ctx.arc(c * gap + gap / 2, r * gap + gap / 2, hot ? 2.6 : 0.6 + v * 1.3, 0, Math.PI * 2);
          ctx.fill();
        }
      }
      ctx.globalAlpha = 1;
    };
    const loop = (t: number) => {
      if (!visible) return;
      if (t - last > 60) { draw(t); last = t; }
      requestAnimationFrame(loop);
    };
    size();
    draw(9000);
    new ResizeObserver(() => { size(); draw(last || 9000); }).observe(canvas);
    new MutationObserver(() => draw(last || 9000)).observe(document.documentElement, { attributes: true, attributeFilter: ["data-theme"] });
    if (still) return;
    new IntersectionObserver(([entry]) => {
      visible = entry.isIntersecting;
      if (visible) requestAnimationFrame(loop);
    }).observe(canvas);
  });

  document.querySelectorAll<HTMLButtonElement>("button.copy").forEach((button) => {
    button.addEventListener("click", async () => {
      await navigator.clipboard.writeText(button.dataset.copy ?? "");
      button.textContent = "Copied";
      setTimeout(() => (button.textContent = "Copy"), 1400);
    });
  });
</script>
