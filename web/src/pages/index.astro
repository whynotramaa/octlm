---
import { getCollection } from "astro:content";
import Base from "../layouts/Base.astro";
import Figure from "../components/Figure.astro";
import CastPlayer from "../widgets/CastPlayer.tsx";
import StoryPlay from "../widgets/StoryPlay.tsx";
import Journey from "../widgets/Journey.tsx";
import EvalGrid from "../widgets/EvalGrid.tsx";
import GroupAdvantage from "../widgets/GroupAdvantage.tsx";
import LineChart from "../charts/LineChart.tsx";
import { roadmap } from "../lib/roadmap.ts";
import day7 from "../data/day7.json";
import metrics from "../data/runs/day4-metrics.json";
import samples from "../data/runs/day4-samples.json";
import spread from "../data/runs/seed-spread.json";
import baseRows from "../data/runs/day7-eval.json";
import eval0 from "../data/runs/day8-eval-0.json";
import eval1 from "../data/runs/day8-eval-1.json";
import int8Rows from "../data/runs/day8-eval-0-int8.json";
import "../styles/landing.css";

const GITHUB = "https://github.com/whynotramaa/octlm";
const posts = (await getCollection("posts")).sort((a, b) => a.data.day - b.data.day || a.data.order - b.data.order);
const experiments = roadmap().flatMap((day) => day.experiments).length;
const firstPost = (day: number) => `/blogs/${posts.find((post) => post.data.day === day)?.id ?? ""}/`;
const postCount = (day: number) => posts.filter((post) => post.data.day === day).length;

const stops = [
  { day: 1, act: "Bytes", title: "Foundations", exps: "EXP-001 to 008", status: "Done", metric: "Bit-identical", unit: "weights after a checkpoint resume", built: "Character and byte-level BPE tokenizers, a decoder, and a training loop. A resumed run matches an uninterrupted one weight for weight, and the model must memorize one fixed block, which proves the loss and optimizer compose." },
  { day: 2, act: "Core", title: "Modern decoder core", exps: "EXP-009 to 015", status: "Done", metric: "4×", unit: "smaller 4K KV cache at two KV heads", built: "RoPE, RMSNorm, SwiGLU and grouped-query attention, each tested against the Day 1 block on a code and prose corpus. Post-norm lost by a full bit per byte on code and was reverted." },
  { day: 3, act: "Pivot", title: "The plan changed", exps: "EXP-016 to 019", status: "Stopped on purpose", metric: "~1%", unit: "of a compute-optimal token budget", built: "Multi-token prediction, sparse attention, compressed KV and MLA were built and tested behind flags. Then the numbers showed the Day 2 models saw about 1 percent of the tokens they needed, so the plan moved to one proper run and a real model." },
  { day: 4, act: "Pretrain", title: "Train it properly", exps: "EXP-065 to 068", status: "Done", metric: "0.4839", unit: "bits per byte on held-out stories", built: "A 26.3M-parameter decoder trained on 393M TinyStories tokens in float16 on one T4, with an 8,192-token BPE learned from the data. Temperature and top-k sampling fix the loops that greedy decoding falls into." },
  { day: 5, act: "Compare", title: "Compare at scale, make it fast", exps: "EXP-069 to 072", status: "Done", metric: "6.8×", unit: "gap over the seed spread", built: "Three seeds per stack. The modern stack beats the baseline by 6.8 times the seed spread. Multi-token prediction loses and stays off. KV caching and int8 weights are measured against the naive code." },
  { day: 6, act: "Qwen", title: "Run Qwen through octlm", exps: "EXP-073 to 076", status: "Done", metric: "2.65e-4", unit: "largest float32 logit gap on a T4", built: "A standard-library safetensors reader loads Qwen3-0.6B into the same decoder file. Tokenizer, chat template and greedy tokens match Transformers exactly." },
  { day: 7, act: "Harness", title: "Build the harness and its eval", exps: "EXP-077 to 079", status: "Done", metric: "0.025", unit: "stock pass^1 over 120 runs", built: "Five tools, one sandbox directory, 40 tasks and three seeds. The stock model passes 3 of 120 runs, mostly because it answers without calling a tool." },
  { day: 8, act: "LoRA", title: "LoRA and tool-use fine-tuning", exps: "EXP-080 to 083", status: "Done", metric: "0.467", unit: "pass^1, up from 0.025", built: "Rank-16 adapters on all seven projections, trained on 74 scripted traces for about five minutes. The merged int8 model keeps the pass rate and halves the stored block weights." },
  { day: 9, act: "GRPO", title: "GRPO on harness tasks", exps: "EXP-084 to 086", status: "Running", metric: "> 0.092", unit: "gain the exit check demands", built: "Group-relative policy optimization with the task check as the reward. No value model, no KL term, a new pool of 33 tasks. It counts only if pass^1 rises by more than the gap between two SFT seeds." },
].map((stop) => ({ ...stop, href: firstPost(stop.day), posts: postCount(stop.day) }));

const curve = metrics.filter((row) => row.type === "training");
const lossSeries = [
  { name: "validation", points: curve.map((r) => [r.step, r.validation_loss] as [number, number]), slot: 1 as const },
  { name: "train batch", points: curve.map((r) => [r.step, r.train_loss] as [number, number]), slot: 2 as const, dashed: true },
];

const seeds = spread.filter((row) => row.type === "seed_run");
const lo = 0.548;
const hi = 0.592;
const dotX = (v: number) => 40 + ((v - lo) / (hi - lo)) * 560;
const mean = (variant: string) => seeds.filter((s) => s.variant === variant).reduce((sum, s, _, all) => sum + s.bits_per_byte / all.length, 0);

const runsOf = (rows: any[]) => rows.filter((row) => row.type === "day7_run").map(({ task, kind, seed, success, calls, valid_calls, turns, answer, stop }) => ({ task, kind, seed, success, calls, valid_calls, turns, answer: answer && answer.slice(0, 240), stop }));
const summary = (rows: any[]) => rows.at(-1);
const models = [
  { name: "Qwen3-0.6B, stock", signal: false, s: summary(baseRows) },
  { name: "LoRA, seed 0", signal: false, s: summary(eval0) },
  { name: "LoRA, seed 1", signal: true, s: summary(eval1) },
  { name: "Seed 0, merged int8", signal: false, s: summary(int8Rows) },
];
const SEGMENTS = 28;
const lit = (value: number, max: number) => Math.round((value / max) * SEGMENTS);

const atlas = [
  { name: "Qwen3-0.6B, stock", runs: runsOf(baseRows) },
  { name: "+ octlm LoRA, seed 1", runs: runsOf(eval1) },
].map((m) => ({ ...m, pass: m.runs.filter((r) => r.success).length }));
const ATLAS_COLS = 20;
const bars = [
  { key: "pass_1_mean", label: "pass^1", max: 1 },
  { key: "valid_call_rate", label: "valid tool calls", max: 1 },
  { key: "mean_turns", label: "mean turns", max: 8 },
];

const decisions = [
  { name: "Modern stack", verdict: "Keep", number: "0.5539", note: "bits per byte against 0.5877 for the baseline, three seeds each" },
  { name: "SwiGLU", verdict: "Keep", number: "−0.082", note: "bits per byte on code at matched parameters" },
  { name: "Two KV heads", verdict: "Keep", number: "16 → 4 MiB", note: "KV cache at 4K context, quality within noise" },
  { name: "Post-norm", verdict: "Revert", number: "+1.00", note: "bits per byte worse on code than pre-norm" },
  { name: "Multi-token prediction", verdict: "Off", number: "+0.0188", note: "bits per byte, against a 0.0050 noise threshold" },
  { name: "Int8 weights", verdict: "Keep", number: "−42%", note: "model bytes for a 0.000025 bits-per-byte change, 20% slower on a T4" },
  { name: "KV cache", verdict: "Keep", number: "Same tokens", note: "as naive decoding at temperature 0, at 64, 256 and 512 tokens" },
  { name: "Merged int8 Qwen", verdict: "Keep", number: "0.375", note: "pass^1 unchanged after merging the LoRA and quantizing" },
];

const runs = [
  { id: "install", label: "Install", lines: [["# Python 3.14 and uv", ""], ["git clone " + GITHUB + ".git", ""], ["cd octlm && uv sync", ""], ["uv run python -m unittest", "# the test suite, on CPU"]] },
  { id: "agent", label: "Watch the agent", lines: [["uv run python -m octlm.demo agent", "# Qwen + LoRA on bug-low-stock"], ["uv run python -m octlm.demo agent --base", "# same task, no adapter"], ["uv run python -m octlm.demo agent --list", "# the 40 eval tasks"], ["uv run python -m octlm.demo agent --task cart-clear", ""]] },
  { id: "stories", label: "Read stories", lines: [["uv run python -m octlm.demo stories", "# Day 4 model, colored by p(token)"], ['uv run python -m octlm.demo stories --prompt "The dragon was tired." --temperature 1.0', ""]] },
  { id: "train", label: "Train from scratch", lines: [["uv run python -m octlm.train --config configs/day1.toml --dry-run", "# config hash, params, logits shape"], ["uv run python -m octlm.tokenizer --vocab-sizes 512 1024 2048", ""], ["uv run python -m octlm.train --tokenizer bpe --overfit", "# the memorization gate"], ["python -m octlm.day4 train", "# EXP-067, on a T4"]] },
  { id: "eval", label: "Run the eval", lines: [["python -m octlm.harness eval", "# 40 tasks × 3 seeds → JSONL"], ["python -m octlm.day8", "# traces, LoRA training, eval"], ["python -m octlm.day9 probe", "# GRPO signal check"]] },
];
---

<Base title="octlm · a language model built from the first byte" description="A from-scratch PyTorch language model lab. A 26M TinyStories model, Qwen3-0.6B in the same decoder, a hand-written LoRA and a tool-use agent, every step measured.">
  <div class="landing tint hue-gray">
    <section class="hero">
      <div class="hero-copy">
        <a class="live" href={firstPost(9)}><span class="live-dot"></span>Day 09 running · GRPO on a Kaggle T4</a>
        <h1 class="hero-title">
          <span class="line"><span>Built from the</span></span>
          <span class="line"><span><em>first byte.</em></span></span>
        </h1>
        <p class="hero-lede">
          octlm is a nine-day lab in PyTorch. It writes the tokenizer and decoder from scratch, trains a 26M model on
          TinyStories, loads Qwen3-0.6B into the same code, and teaches it to fix bugs with a LoRA written by hand.
          Every number on this page comes from a logged run.
        </p>
        <div class="hero-actions">
          <a class="btn" href="/blogs/">
            Read the build log
            <svg viewBox="0 0 20 20" aria-hidden="true"><path d="M4 10h11m-4-4.5L15.5 10 11 14.5" /></svg>
          </a>
          <a class="btn ghost" href={GITHUB}>GitHub</a>
          <a class="text-link" href="#run">Run it locally</a>
        </div>
      </div>

      <figure class="atlas" aria-label={`Agent eval: stock model passes ${atlas[0].pass} of 120 runs, the LoRA model passes ${atlas[1].pass}`}>
        <div class="atlas-head">
          <span class="mono-label">Fig. 0 · agent eval, 120 runs each</span>
          <span class="mono-label">day7 + day8 evals</span>
        </div>
        {atlas.map((m) => (
          <div class="atlas-row">
            <div class="atlas-meta">
              <span>{m.name}</span>
              <span class="atlas-count"><b>{m.pass}</b> / {m.runs.length}</span>
            </div>
            <svg viewBox={`0 0 ${ATLAS_COLS * 14} ${Math.ceil(m.runs.length / ATLAS_COLS) * 14}`} aria-hidden="true">
              {m.runs.map((r, i) => (
                <circle cx={(i % ATLAS_COLS) * 14 + 7} cy={Math.floor(i / ATLAS_COLS) * 14 + 7} r={r.success ? 4.2 : 2.6} class={r.success ? "on" : "off"} style={`--i:${i}`} />
              ))}
            </svg>
          </div>
        ))}
        <figcaption>
          <span class="atlas-metric display">0.025 <span>→</span> 0.467</span>
          <span class="atlas-note">pass^1 across 40 tasks × 3 seeds. Each dot is one run of the real harness. Lit dots fixed the bug.</span>
        </figcaption>
      </figure>
    </section>

    <section class="index" aria-label="Headline numbers">
      {[
        ["26.3M", "parameters trained from scratch", "Day 04"],
        ["393M", "TinyStories tokens, 4.1 h on one T4", "Day 04"],
        ["0.4839", "bits per byte on held-out stories", "Day 04"],
        ["2.65e-4", "largest logit gap to Transformers, Qwen3-0.6B", "Day 06"],
        ["0.33 → 0.98", "share of tool calls that parse and validate", "Day 08"],
        [String(experiments), "experiments in the plan, each with an exit check", "Days 01–09"],
      ].map(([value, label, day], i) => (
        <div class="index-item" data-reveal style={`--i:${i}`}>
          <span class="index-day">{day}</span>
          <span class="index-value display">{value}</span>
          <span class="index-label">{label}</span>
        </div>
      ))}
    </section>

    <section class="block">
      <header class="sec-head">
        <div class="sec-meta"><span class="sec-num">01</span><span class="mono-label">Method</span></div>
        <h2 class="sec-title display">No number without a <em>baseline.</em></h2>
        <p class="intro">
          Each experiment opens with a problem, a hypothesis, a baseline, a measurement and a stop condition. It closes
          with keep or revert. Failed ideas stay in the notes with their numbers. The code leans on the standard library
          and PyTorch, and on nothing it can avoid.
        </p>
      </header>
      <ol class="tenets">
        {[
          [`${experiments} experiments, measured`, "Three seeds set the noise floor. A result counts only when its gap beats the spread."],
          ["Every choice cites a source", "Papers, model reports and official code, each named in the day note next to the decision it caused."],
          ["Written here, not imported", "BPE, attention, RoPE, KV cache, int8, LoRA, a safetensors reader and the agent harness all live in octlm."],
        ].map(([title, text], i) => (
          <li data-reveal style={`--i:${i}`}>
            <span class="tenet-num">{`0${i + 1}`}</span>
            <h3>{title}</h3>
            <p>{text}</p>
          </li>
        ))}
      </ol>
    </section>

    <section class="block">
      <header class="sec-head">
        <div class="sec-meta"><span class="sec-num">02</span><span class="mono-label">Nine days</span></div>
        <h2 class="sec-title display">From raw bytes to an agent that <em>fixes bugs.</em></h2>
        <p class="intro">Each day has one note, a set of experiments and an exit check. Hover a day to see what it built and the number that closed it.</p>
      </header>
      <Journey client:visible stops={stops} />
    </section>

    <section class="block">
      <header class="sec-head">
        <div class="sec-meta"><span class="sec-num">03</span><span class="mono-label">From scratch</span></div>
        <h2 class="sec-title display">26 million parameters that <em>tell stories.</em></h2>
        <p class="intro">
          One decoder, trained once and trained properly. 24,000 steps of 32 sequences of 512 tokens, float16 with a
          gradient scaler, cosine decay to a tenth of the peak rate. Validation loss is the same 131,072 held-out tokens at
          every checkpoint.
        </p>
      </header>
      <div class="spec-grid">
        <dl class="spec" data-reveal>
          <div class="spec-title mono-label">Spec sheet · Day 04 model</div>
          {[
            ["Layers", "8"],
            ["Width", "512"],
            ["Heads", "8 query · 2 KV"],
            ["Context", "512 tokens"],
            ["Vocabulary", "8,192 byte-level BPE"],
            ["Positions", "RoPE"],
            ["MLP", "SwiGLU"],
            ["Norm", "RMSNorm, pre-norm"],
            ["Precision", "float16 + GradScaler"],
            ["Compute", "one T4, 4.1 hours"],
          ].map(([k, v]) => (<div class="spec-row"><dt>{k}</dt><dd>{v}</dd></div>))}
        </dl>
        <div class="panel" data-reveal style="--i:1">
          <div class="panel-head"><span>Loss over 24,000 steps</span><span class="panel-tag">day4-metrics.json</span></div>
          <LineChart client:visible series={lossSeries} x={{ label: "step" }} y={{ label: "nats per token", format: "fixed2" }} markers height={300} />
        </div>
      </div>
      <div class="live-term" data-reveal>
        <div class="live-copy">
          <span class="mono-label">Live on a laptop CPU</span>
          <p>The Day 4 model writing a story, recorded with the real demo command. Each token is colored by the probability the model gave it.</p>
          <div class="probs">
            <span class="p p9">≥ 0.9</span><span class="p p5">≥ 0.5</span><span class="p p2">≥ 0.2</span><span class="p p0">&lt; 0.2</span>
          </div>
        </div>
        <CastPlayer client:visible src="/demo/stories.cast" title="octlm stories · 26.3M params · laptop CPU" height={18} />
      </div>
      <div class="panel play-panel" data-reveal>
        <div class="panel-head"><span>Story time · pick a first line, the model writes the rest</span><span class="panel-tag">day4-samples.json</span></div>
        <StoryPlay client:visible samples={samples} />
      </div>
    </section>

    <section class="block">
      <header class="sec-head">
        <div class="sec-meta"><span class="sec-num">04</span><span class="mono-label">Decisions</span></div>
        <h2 class="sec-title display">Every idea had to <em>beat the noise.</em></h2>
        <p class="intro">
          Three seeds of each stack on 98.3M tokens set the floor. The six dots below are those runs. Anything smaller than
          the spread inside a group is not a result.
        </p>
      </header>
      <div class="panel spread" data-reveal>
        <div class="panel-head"><span>Bits per byte, three seeds each, lower is better</span><span class="panel-tag">seed-spread.json</span></div>
        <svg viewBox="0 0 640 150" role="img" aria-label={`Modern averages ${mean("modern").toFixed(4)} bits per byte, baseline ${mean("baseline").toFixed(4)}`}>
          <line x1="40" x2="600" y1="96" y2="96" class="axis" />
          {[0.55, 0.56, 0.57, 0.58, 0.59].map((t) => (<g><line x1={dotX(t)} x2={dotX(t)} y1="92" y2="100" class="axis" /><text x={dotX(t)} y="122" class="tick">{t.toFixed(2)}</text></g>))}
          <line x1={dotX(mean("modern"))} x2={dotX(mean("baseline"))} y1="40" y2="40" class="gap" />
          <text x={(dotX(mean("modern")) + dotX(mean("baseline"))) / 2} y="30" class="gap-label">gap 0.0338 · 6.8× the spread</text>
          {seeds.map((s, i) => (<circle cx={dotX(s.bits_per_byte)} cy={68 + (i % 3) * 7 - 7} r="6" class={`dot ${s.variant}`} />))}
          <text x={dotX(mean("modern"))} y="146" class="name modern">modern</text>
          <text x={dotX(mean("baseline"))} y="146" class="name baseline">baseline</text>
        </svg>
      </div>
      <div class="ledger">
        {decisions.map((d, i) => (
          <article class={`ledger-item${d.verdict === "Keep" ? "" : " flag"}`} data-reveal style={`--i:${i}`}>
            <span class="ledger-verdict">{d.verdict}</span>
            <h3>{d.name}</h3>
            <span class="ledger-number display">{d.number}</span>
            <p>{d.note}</p>
          </article>
        ))}
      </div>
    </section>

    <section class="block">
      <header class="sec-head">
        <div class="sec-meta"><span class="sec-num">05</span><span class="mono-label">A real model</span></div>
        <h2 class="sec-title display">Same decoder file. <em>Real weights.</em></h2>
      </header>
      <div class="parity">
        <div class="parity-hero dotfield" data-reveal>
          <span class="mono-label">Largest logit gap</span>
          <span class="parity-number display">2.65<span>×10⁻⁴</span></span>
          <p>Largest float32 logit difference between octlm and Hugging Face Transformers, Qwen3-0.6B on a T4. Tokenizer, chat template and greedy tokens match exactly.</p>
        </div>
        <div class="parity-side" data-reveal style="--i:1">
          <pre class="ascii" aria-label="Safetensors file layout">{`┌──────────┬────────────────────┬─────────────────────────┐
│ u64  n   │  JSON header (n B) │  raw tensor bytes  ···  │
└──────────┴────────────────────┴─────────────────────────┘
   struct        json.loads        memoryview → torch`}</pre>
          <p class="parity-note">The weights load through <code>struct</code> and <code>json</code> from the standard library. No safetensors package.</p>
          <ul class="facts">
            <li><span>Layers</span>28</li>
            <li><span>Width</span>1,024</li>
            <li><span>Heads</span>16 query · 8 KV</li>
            <li><span>Extras</span>QK-norm, RoPE base 10⁶</li>
            <li><span>Vocabulary</span>151,936</li>
            <li><span>Parameters</span>596M</li>
          </ul>
        </div>
      </div>
    </section>

    <section class="block">
      <header class="sec-head">
        <div class="sec-meta"><span class="sec-num">06</span><span class="mono-label">The agent</span></div>
        <h2 class="sec-title display">Same task, same seed. <em>One adapter apart.</em></h2>
        <p class="intro">
          The harness shows the model a failing repository and five tools. It parses each call, runs it in a sandbox and
          feeds the result back until the model answers or hits eight turns. Both recordings run the real eval loop on a
          laptop CPU.
        </p>
      </header>
      <pre class="ascii loop" aria-label="Harness loop">{`  task ──▶ model ──▶ <tool_call> ──▶ parse + validate ──▶ sandbox
             ▲                                               │
             └──────────────── tool result ◀─────────────────┘
  tools   list_files · read_file · grep · write_file · run_tests`}</pre>
      <div class="duo">
        <div data-reveal>
          <div class="duo-label"><span class="pill fail">Stock</span>Answers in prose. No tool call.</div>
          <CastPlayer client:visible src="/demo/agent-base.cast" title="Qwen3-0.6B · no adapter" height={18} status="fail" />
        </div>
        <div data-reveal style="--i:1">
          <div class="duo-label"><span class="pill pass">LoRA</span>Runs tests, reads, fixes, reruns.</div>
          <CastPlayer client:visible src="/demo/agent-lora.cast" title="Qwen3-0.6B + octlm LoRA" height={18} status="pass" />
        </div>
      </div>
      <p class="aside">One CPU run is one sample. It shows the result, it does not measure it. The measurement is the grid below.</p>

      <div class="panel" data-reveal>
        <div class="panel-head"><span>40 tasks × 3 sampling seeds, on a T4</span><span class="panel-tag">day7 + day8 evals</span></div>
        <div class="meters">
          {bars.map((bar) => (
            <div class="meter">
              <span class="meter-name">{bar.label}</span>
              {models.map((m) => (
                <div class:list={["meter-row", { signal: m.signal }]}>
                  <span class="meter-model">{m.name}</span>
                  <span class="meter-value">{m.s[bar.key].toFixed(bar.key === "mean_turns" ? 2 : 3)}</span>
                  <span class="meter-track" aria-hidden="true">
                    {Array.from({ length: SEGMENTS }, (_, i) => <i class={i < lit(m.s[bar.key], bar.max) ? "on" : undefined} style={`--i:${i}`} />)}
                  </span>
                </div>
              ))}
            </div>
          ))}
        </div>
      </div>
      <Figure label="Every run, clickable" caption="Each square is one run. Pick one to read its task and final answer. Switch models to see which tasks flipped.">
        <EvalGrid client:visible tasks={day7.tasks.map(({ id, prompt, check }) => ({ id, prompt, check: { kind: check.kind } }))} sets={[{ value: "base", text: "Stock", runs: runsOf(baseRows) }, { value: "seed0", text: "LoRA seed 0", runs: runsOf(eval0) }, { value: "seed1", text: "LoRA seed 1", runs: runsOf(eval1) }]} start="seed1" label="Model" flippedText="different result from the reference" />
      </Figure>
    </section>

    <section class="block">
      <header class="sec-head">
        <div class="sec-meta"><span class="sec-num">07</span><span class="mono-label signal-text">Running now</span></div>
        <h2 class="sec-title display">Learn from the <em>test results themselves.</em></h2>
        <p class="intro">
          SFT taught the tool format but not debugging. Day 9 samples six rollouts per task, scores each with the task
          check, and pushes up the ones that beat their group. Groups where every rollout agrees carry no gradient and get
          dropped. Click the rollouts to see the advantage each one gets.
        </p>
      </header>
      <Figure label="Group-relative advantage, a playground" caption="An illustration, not a result. The Day 9 run is on a Kaggle T4 and its numbers land in notes/day9.md.">
        <GroupAdvantage client:visible size={6} />
      </Figure>
    </section>

    <section class="block run" id="run">
      <header class="sec-head">
        <div class="sec-meta"><span class="sec-num">08</span><span class="mono-label">Run it</span></div>
