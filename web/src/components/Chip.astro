---
interface Props {
  hue?: "blue" | "green" | "orange" | "red" | "purple" | "cyan" | "gray";
  size?: "sm" | "md";
  href?: string;
}

const { hue = "gray", size = "sm", href } = Astro.props;
const Tag = href ? "a" : "span";
---

<Tag class:list={["chip", "tint", `hue-${hue}`, size]} href={href}><slot /></Tag>

<style>
  .chip {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-weight: 560;
    color: var(--tint-fg);
    background: linear-gradient(180deg, var(--tint-surface), var(--tint-bottom));
    border: 1px solid var(--tint-border);
    box-shadow: 0 1px 1px rgb(0 0 0 / 0.02), 0 2px 6px -3px rgb(0 0 0 / 0.06);
    white-space: nowrap;
    text-decoration: none;
    line-height: 1;
    transition: border-color var(--fast) var(--ease);
  }
  .sm { height: 28px; padding: 0 11px; font-size: 13px; border-radius: 9px; }
  .md { height: 44px; padding: 0 18px; font-size: 15px; border-radius: var(--r-chip); }
  a.chip:hover { border-color: var(--tint-fg); }
  .chip :global(svg) { width: 16px; height: 16px; flex: none; }
  .md :global(svg) { width: 20px; height: 20px; }
</style>
